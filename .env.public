# WANDB_GROUP=skill_knowledge_bench
# WANDB_TAGS=skills-mcp,plan-execute
# WANDB_MODE=online
# WANDB_RUN_NAME=
# WANDB_JOB_TYPE=
# WANDB_LOG_EACH_PLAN_EXECUTE=0
