# ── CouchDB (IoTAgent server) ────────────────────────────────────────────────
COUCHDB_URL=http://localhost:5984
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=password
IOT_DBNAME=chiller                                                             
WO_DBNAME=workorder

# ── IBM WatsonX (plan-execute runner) ────────────────────────────────────────
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com   # optional

# ── LiteLLM (plan-execute runner) ─────────────────────────────────────────────
LITELLM_API_KEY=
LITELLM_BASE_URL=

# ── Skills MCP server ─────────────────────────────────────────────────────────
# If 1: on first ``skills-mcp-server`` start, create install state with all bundled FQIDs when the file is missing (plan-execute / CLI convenience).
SKILL_BOOTSTRAP_INSTALL=1

# ── Weights & Biases (optional; install: uv sync --group wandb) ───────────────
# See docs/WandB_Integration.md
WANDB_ENABLED=0
WANDB_PROJECT=
